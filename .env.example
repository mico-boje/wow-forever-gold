# Create a client at https://develop.battle.net/access/clients
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# us | eu | kr | tw
WOWGOLD_REGION=eu
WOWGOLD_LOCALE=en_GB
WOWGOLD_DATA_DIR=data
# Versioned static namespace fallback, e.g. static-1.60.1_70399-forever-eu
WOWGOLD_STATIC_VERSION=1.60.1_70399
# Auction houses you trade on (see `wowgold houses list`), JSON list. Empty = all.
WOWGOLD_HOUSES=[]
